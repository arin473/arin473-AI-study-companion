# Google Gemini API Key — read ONLY by the backend server (never exposed to browser)
# Obtain from https://aistudio.google.com/
# Without this key, the app runs in Grounded Core Mode (text-only fallback).
GEMINI_API_KEY=

# Optional: override the model used by the backend (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Note: VITE_ prefixed vars are bundled into the frontend JS and visible to anyone.
# Do NOT add your API key as VITE_GEMINI_API_KEY — it belongs only in GEMINI_API_KEY above.
